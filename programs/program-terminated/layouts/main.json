{
  "schema": 1,
  "id": "main",
  "root": {
    "id": "dump",
    "type": "stack",
    "children": [
      {
        "id": "top-actions",
        "type": "actions",
        "actions": ["home", "copy", "end"],
        "primary": true
      },
      {
        "id": "summary",
        "type": "grid",
        "columns": 2,
        "responsive": "stack",
        "children": [
          {
            "id": "exception-summary",
            "type": "section",
            "title": "Exception",
            "controls": ["exception-type", "message", "properties"]
          },
          {
            "id": "execution-summary",
            "type": "section",
            "title": "Execution",
            "controls": [
              "program-id",
              "entrypoint",
              "location",
              "occurred-at",
              "copy-status"
            ]
          }
        ]
      },
      {
        "id": "technical-details",
        "type": "tabs",
        "selectedTab": "call-stack",
        "children": [
          {
            "id": "call-stack",
            "type": "section",
            "title": "Call stack",
            "controls": ["stack"]
          },
          {
            "id": "source-code",
            "type": "section",
            "title": "Source code",
            "controls": ["source"]
          },
          {
            "id": "complete-dump",
            "type": "section",
            "title": "Complete short dump",
            "controls": ["dump-text"]
          }
        ]
      }
    ]
  }
}
