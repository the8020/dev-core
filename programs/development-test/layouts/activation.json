{
  "schema": 1,
  "id": "development-activation",
  "root": {
    "id": "root",
    "type": "stack",
    "children": [
      {
        "id": "changed-packages",
        "type": "list",
        "title": "Changed packages",
        "bind": "packages",
        "key": "package",
        "display": [
          "change",
          "package",
          "ready",
          "changedFiles",
          "addedRows",
          "removedRows"
        ],
        "headings": {
          "addedRows": "+",
          "removedRows": "-"
        },
        "columnOptions": {
          "change": {
            "length": "short"
          },
          "changedFiles": {
            "length": "compact",
            "shortHeading": "Files"
          },
          "addedRows": {
            "length": "compact",
            "shortHeading": "+",
            "heading": "Added rows"
          },
          "removedRows": {
            "length": "compact",
            "shortHeading": "\u2212",
            "heading": "Removed rows"
          }
        }
      },
      {
        "id": "activation",
        "type": "field-group",
        "title": "Activation",
        "controls": [
          "message",
          "status"
        ]
      }
    ]
  }
}
