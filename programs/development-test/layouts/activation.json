{
  "schema": 1,
  "id": "development-activation",
  "root": {
    "id": "root",
    "type": "stack",
    "children": [
      {
        "id": "changed-packages",
        "type": "list",
        "title": {
          "package": "the8020/dev-core",
          "key": "program.changed_packages",
          "fallback": "Changed packages"
        },
        "bind": "packages",
        "key": "package",
        "display": [
          "change",
          "package",
          "ready",
          "changedFiles",
          "addedRows",
          "removedRows"
        ],
        "headings": {
          "addedRows": "+",
          "removedRows": "-"
        },
        "columnOptions": {
          "change": {
            "length": "short"
          },
          "changedFiles": {
            "length": "compact",
            "shortHeading": {
              "package": "the8020/dev-core",
              "key": "layout.files",
              "fallback": "Files"
            }
          },
          "addedRows": {
            "length": "compact",
            "shortHeading": "+",
            "heading": "Added rows"
          },
          "removedRows": {
            "length": "compact",
            "shortHeading": "−",
            "heading": "Removed rows"
          }
        }
      },
      {
        "id": "activation",
        "type": "field-group",
        "title": {
          "package": "the8020/dev-core",
          "key": "layouts.development-test.activation.activation.title",
          "fallback": "Activation"
        },
        "controls": [
          "message",
          "status"
        ]
      }
    ]
  }
}
