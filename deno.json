{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@xterm/addon-fit": "npm:@xterm/addon-fit@0.11.0",
    "@xterm/xterm": "npm:@xterm/xterm@6.0.0"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check programs/*/*.ts src/*.ts services/*/service.ts tables/*.ts terminals/frontend/console.ts terminals/browser_scenarios.ts terminals/native*_scenarios.ts",
    "build": "deno run -A terminals/build.ts",
    "build:code-browser": "deno run -A programs/code-browser/build.ts",
    "test": "deno test --allow-read --allow-write terminals programs/code-browser",
    "test:browser": "deno run -A ../uui/presentation_browser_e2e.ts --fixture=../dev-core/terminals/browser_scenarios.ts",
    "test:native-browser": "deno run -A ../uui/browser_e2e.ts --fixture=../dev-core/terminals/native_browser_scenarios.ts",
    "test:native-resilience": "deno run -A ../uui/browser_e2e.ts --fixture=../dev-core/terminals/native_resilience_scenarios.ts",
    "test:native-idle": "deno run -A ../uui/browser_e2e.ts --fixture=../dev-core/terminals/native_idle_scenarios.ts",
    "bench:native-terminals": "deno run -A ../uui/browser_e2e.ts --fixture=../dev-core/terminals/native_performance_scenarios.ts"
  },
  "fmt": {
    "exclude": [
      "public"
    ]
  },
  "lint": {
    "exclude": [
      "public"
    ]
  }
}
